+void quote(std::ostream& o,std::string_view s)
+{
+    o<<'"';constexpr char hex[]="0123456789abcdef";
+    for(unsigned char c:s)
+    {
+        if(c=='"'||c=='\\')o<<'\\'<<char(c);
+        else if(c<32)o<<"\\u00"<<hex[c>>4]<<hex[c&15];
+        else o<<char(c);
+    }
+    o<<'"';
